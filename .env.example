# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 .gitignore에 있어 커밋되지 않습니다.
# Streamlit Community Cloud에 배포한 경우에는 .env 대신
# 앱 관리 화면 > Settings > Secrets 에 같은 키를 TOML 형식으로 넣으면 됩니다.

# ---------------------------------------------------------------------
# Slack 이상 탐지 알림
# ---------------------------------------------------------------------
# Slack Incoming Webhook URL. 발급 방법:
#   1. https://api.slack.com/apps 에서 Create New App > From scratch
#   2. 워크스페이스 선택 후 Incoming Webhooks 활성화
#   3. Add New Webhook to Workspace 로 알림 받을 채널 선택
#   4. 생성된 https://hooks.slack.com/services/... URL을 아래에 붙여넣기
# 비워두면 경보는 대시보드 이력에만 기록되고 Slack 전송은 건너뜁니다.
SLACK_WEBHOOK_URL=

# Slack으로 보낼 최소 심각도: warning | critical
SLACK_ALERT_MIN_SEVERITY=warning

# ---------------------------------------------------------------------
# 백엔드 연결 (선택)
# ---------------------------------------------------------------------
# API를 별도 호스트에 배포했을 때만 지정. 비워두면 대시보드가 같은 프로세스에서
# API를 기동하거나, 로컬에 이미 떠 있는 API에 연결합니다.
# WAFER_API_URL=https://your-api-host.example.com
# WAFER_API_PORT=8000
